# ============================================================================
# AI-Test-Agent Environment Configuration - EXAMPLE TEMPLATE
# ============================================================================
# IMPORTANT: Copy this file to .env and fill in your actual values
# Command: cp .env.example .env
# ============================================================================

# ============================================================================
# ⚠️ REQUIRED: Claude AI (Anthropic) Configuration
# ============================================================================
# Get your API key from: https://console.anthropic.com/
# Steps:
#   1. Sign up at https://console.anthropic.com
#   2. Go to API Keys section
#   3. Create new API key
#   4. Copy and paste here

# REQUIRED: Your Claude API Key
ANTHROPIC_API_KEY=sk-ant-v0-EXAMPLE_KEY_1234567890ABCDEF

# ============================================================================
# Playwright Configuration (Optional - Defaults provided)
# ============================================================================

# Browser: chromium | firefox | webkit
PLAYWRIGHT_BROWSER=chromium

# Headless mode
PLAYWRIGHT_HEADLESS=true

# Screenshot on failure
PLAYWRIGHT_SCREENSHOT_ON_FAILURE=true

# Trace on failure (for debugging)
PLAYWRIGHT_TRACE_ON_FAILURE=true

# Timeouts in milliseconds
PLAYWRIGHT_TIMEOUT=60000
PLAYWRIGHT_NAVIGATION_TIMEOUT=30000

# Test retries and parallelism
PLAYWRIGHT_RETRIES=2
PLAYWRIGHT_WORKERS=4

# ============================================================================
# GitHub Copilot CLI Configuration (Optional)
# ============================================================================

# Copilot debugging
COPILOT_DEBUG=false

# ============================================================================
# Test Execution Settings (Optional)
# ============================================================================

# Global test timeout
TEST_TIMEOUT=60000

# Max retries on failure
MAX_RETRIES=3

# ============================================================================
# Report Configuration (Optional)
# ============================================================================

# Report format
REPORT_FORMAT=json

# Verbosity: quiet | normal | verbose
REPORT_VERBOSITY=verbose

# Output directories
REPORT_OUTPUT_DIR=./reports
SCREENSHOT_OUTPUT_DIR=./reports/screenshots
TRACE_OUTPUT_DIR=./reports/traces

# ============================================================================
# Logging (Optional)
# ============================================================================

# Log level: ERROR | WARN | INFO | DEBUG
LOG_LEVEL=INFO

# Colored output
LOG_COLOR=true

# ============================================================================
# Claude Generator Agent (Optional)
# ============================================================================

# Model selection
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Max tokens for code generation
CLAUDE_MAX_TOKENS=4096

# Temperature (0=deterministic, 1=creative)
CLAUDE_TEMPERATURE=0.3

# Validate generated code before saving
CLAUDE_VALIDATE_CODE=true

# ============================================================================
# Copilot Analyzer Agent (Optional)
# ============================================================================

# Enable AI analysis
COPILOT_ANALYSIS_ENABLED=true

# Analysis model
COPILOT_MODEL=gpt-4o

# Max analysis tokens
COPILOT_MAX_TOKENS=2000

# ============================================================================
# Executor Agent (Optional)
# ============================================================================

# Execution timeout
EXECUTOR_TIMEOUT=120000

# Capture test logs
EXECUTOR_CAPTURE_LOGS=true

# Executor retries
EXECUTOR_RETRIES=2

# ============================================================================
# Environment & Advanced (Optional)
# ============================================================================

# Environment: development | production | test
NODE_ENV=development

# Debug mode
DEBUG=false

# Proxy (if behind corporate firewall)
# HTTP_PROXY=http://proxy.company.com:8080
# HTTPS_PROXY=http://proxy.company.com:8080

# ============================================================================
# Future: MCP Server Configuration (Sprint 6+)
# ============================================================================

# GitHub Integration
# GITHUB_TOKEN=ghp_YOUR_TOKEN_HERE

# Jira Integration
# JIRA_API_TOKEN=YOUR_TOKEN_HERE

# Slack Integration
# SLACK_BOT_TOKEN=xoxb-YOUR_TOKEN_HERE

# Database Integration
# DATABASE_URL=postgresql://user:password@localhost:5432/testdb

# ============================================================================
# QUICK START CHECKLIST
# ============================================================================
# ✅ Step 1: Get Anthropic API Key
#    Visit: https://console.anthropic.com/api/keys
#    Copy your key
#
# ✅ Step 2: Update ANTHROPIC_API_KEY in .env
#    Replace: sk-ant-v0-EXAMPLE_KEY_1234567890ABCDEF
#    With:    Your actual key
#
# ✅ Step 3: Verify npm packages installed
#    Run: npm install
#
# ✅ Step 4: Test the setup
#    Run: npm start "Test MSN at https://www.msn.com"
#
# ============================================================================
